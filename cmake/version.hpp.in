/*
 * version.hpp - the release this header belongs to.
 *
 * Generated by CMake from cmake/version.hpp.in; do not edit the copy in the
 * build tree. The macros come from project(StreamParser VERSION ...), so a
 * downstream can say `#if SP_VERSION_MAJOR >= 1` without a configure step of
 * its own, and a bug report can quote sp::version().
 */
#ifndef SP_VERSION_HPP
#define SP_VERSION_HPP

#define SP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SP_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define SP_VERSION_STRING "@PROJECT_VERSION@"

namespace sp {

inline const char *version() { return SP_VERSION_STRING; }

}  // namespace sp

#endif  // SP_VERSION_HPP
